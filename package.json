{
  "name": "corral",
  "version": "1.0.0",
  "private": true,
  "description": "Corral - 研发服务器管理工具",
  "author": "ZongBowen <zongbowen1992@hotmail.com>",
  "homepage": "https://github.com/ZongBowen/corral",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "node --env-file-if-exists=electron-builder.env ./node_modules/electron/install.js",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "iconv-lite": "^0.7.3",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint-react/eslint-plugin": "^5.30.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.2",
    "anser": "^2.3.5",
    "antd": "^6.7.1",
    "dayjs": "^1.11.23",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "nanoid": "^6.0.2",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "cpu-features@0.0.10": true,
    "ssh2@1.17.0": true
  }
}
